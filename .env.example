# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPEN_API_KEY=your-openai-api-key-here

# LangChain Configuration
LANGCHAIN_API_KEY=your-langchain-api-key-here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Vector Database Path (relative to src/)
# CRITICAL: This must point to where your FAISS indices are stored
VECTOR_DB_PATH=data/faiss_store

# SQLite Database (auto-created at src/data/app.db)
# DATABASE_URL=sqlite:///./data/app.db

# JWT Configuration
SECRET_KEY=your-secret-key-for-jwt-tokens-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Web Scraping
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
